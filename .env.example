# Application
SECRET_KEY=dev-secret-change-in-production
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./cobalt_lab.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keycloak / OIDC
OIDC_ISSUER_URL=http://localhost:8080/realms/cobalt-lab
OIDC_CLIENT_ID=cobalt-lab
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback

# LLM (optional)
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
